{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "starting_gold",
    "starting_lives",
    "waves",
    "wave_bonus",
    "towers",
    "progression"
  ],
  "additionalProperties": false,
  "properties": {
    "starting_gold": {
      "type": "integer",
      "minimum": 1
    },
    "starting_lives": {
      "type": "integer",
      "minimum": 1
    },
    "waves": {
      "type": "integer",
      "minimum": 1
    },
    "wave_bonus": {
      "type": "integer",
      "minimum": 1
    },
    "towers": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "cost",
          "damage",
          "range",
          "cooldown",
          "color",
          "splash",
          "slow",
          "name_key",
          "description_key",
          "behavior"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "damage": {
            "type": "number",
            "minimum": 0
          },
          "range": {
            "type": "number",
            "minimum": 0
          },
          "cooldown": {
            "type": "number",
            "minimum": 0
          },
          "color": {
            "type": "string"
          },
          "splash": {
            "type": "number",
            "minimum": 0
          },
          "slow": {
            "type": "number",
            "minimum": 0
          },
          "name_key": {
            "type": "string"
          },
          "description_key": {
            "type": "string"
          },
          "behavior": {
            "enum": [
              "single",
              "splash",
              "slow",
              "poison",
              "chain",
              "pierce",
              "aura"
            ]
          },
          "poison_dps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "poison_duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "chain_jumps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "chain_radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "chain_decay": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pierce_hits": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pierce_tolerance": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "aura_bonus": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "behavior": {
                  "const": "aura"
                }
              }
            },
            "then": {
              "properties": {
                "damage": {
                  "const": 0
                },
                "cooldown": {
                  "const": 0
                }
              },
              "required": [
                "aura_bonus"
              ]
            },
            "else": {
              "properties": {
                "damage": {
                  "exclusiveMinimum": 0
                },
                "cooldown": {
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "behavior": {
                  "const": "poison"
                }
              }
            },
            "then": {
              "required": [
                "poison_dps",
                "poison_duration"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "behavior": {
                  "const": "chain"
                }
              }
            },
            "then": {
              "required": [
                "chain_jumps",
                "chain_radius",
                "chain_decay"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "behavior": {
                  "const": "pierce"
                }
              }
            },
            "then": {
              "required": [
                "pierce_hits",
                "pierce_tolerance"
              ]
            }
          }
        ]
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "damage_multipliers",
        "range_additions",
        "aura_bonuses",
        "upgrade_multipliers",
        "refund_factor"
      ],
      "properties": {
        "damage_multipliers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "range_additions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "aura_bonuses": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "upgrade_multipliers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "refund_factor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
